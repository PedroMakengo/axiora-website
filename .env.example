# Copiar para .env e preencher (XAMPP / cPanel). NUNCA versionar o .env real.
# Em produção, colocar o .env UM NÍVEL ACIMA da pasta pública quando possível.
# No Docker/Coolify estas variáveis vêm do ambiente (ver docker-compose.yml).

# local | producao
APP_AMBIENTE=local
APP_URL=https://www.axiora.site

DB_HOST=localhost
DB_PORTA=3306
DB_NOME=axiora
DB_USER=root
DB_SENHA=

# Administrador criado por "php database/instalar.php" (só se ainda não existir nenhum).
# Sem ADMIN_SENHA é gerada uma senha aleatória, mostrada no terminal.
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@axiora.site
ADMIN_SENHA=

# SMTP — usado na recuperação de senha do painel
MAIL_HOST=
MAIL_PORT=465
MAIL_ENCRIPTACAO=ssl
MAIL_UTILIZADOR=
MAIL_SENHA=
MAIL_DE=
